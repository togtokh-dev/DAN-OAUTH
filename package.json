{
  "name": "dan-oauth",
  "version": "1.0.0",
  "description": "Node.js client for DAN (sso.gov.mn), Mongolia's national OAuth 2.0 single sign-on, for fetching citizen data from XYP (ХУР) services",
  "keywords": [
    "dan",
    "sso.gov.mn",
    "oauth2",
    "xyp",
    "хур",
    "mongolia",
    "e-mongolia",
    "citizen"
  ],
  "author": "togtokh-dev <togtokh.dev@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/togtokh-dev/DAN-OAUTH.git"
  },
  "bugs": {
    "url": "https://github.com/togtokh-dev/DAN-OAUTH/issues"
  },
  "homepage": "https://github.com/togtokh-dev/DAN-OAUTH#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
